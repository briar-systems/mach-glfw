# Vulkan interop.
#
# GLFW owns the window and therefore the platform surface a Vulkan swapchain
# presents to. These four calls are the whole boundary between the two: ask
# whether Vulkan is usable, ask which instance extensions a surface needs,
# create the surface, and resolve instance-level entry points.
#
# The surface is returned as a u64 rather than a typed handle because
# VkSurfaceKHR is a non-dispatchable handle, which is a 64-bit integer on every
# platform regardless of pointer width. Typing it here would force a dependency
# on a Vulkan binding, and this library has none.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use glfw.c;
use glfw.error;
use glfw.error.Error;
use glfw.window.Window;

# Why a Vulkan surface could not be created.
# ---
# glfw:   glfw refused before the platform produced a Vulkan result, for example
#         api_unavailable when the loader or surface extensions are missing
# vulkan: the nonzero VkResult glfw returned from the platform surface call
pub tag SurfaceError: u8 {
    glfw:   Error;
    vulkan: i32;
}

# Whether a Vulkan loader and at least one ICD are available.
#
# False means no surface can be created, so a caller should fall back rather
# than proceed and fail later with a less obvious error.
pub fun vulkan_supported() bool {
    ret c.glfwVulkanSupported() != 0;
}

# The instance extensions required to create a surface on this platform.
#
# The returned array is owned by GLFW and lives until termination, so it must
# not be freed. Passing these to VkInstanceCreateInfo is mandatory: an instance
# created without them cannot present.
# ---
# count: receives the number of extension names, zero if Vulkan is unavailable
# ret:   array of null-terminated names, count entries long
pub fun required_instance_extensions(count: *u32) **u8 {
    ret c.glfwGetRequiredInstanceExtensions(count);
}

# Create a Vulkan surface for a window.
#
# The window must have been created with the NO_API client hint.
# ---
# instance: the VkInstance to create the surface against
# window:   the window to present to
# ret:      the VkSurfaceKHR handle, or why it could not be created
pub fun create_window_surface(instance: ptr, window: Window) res[u64, SurfaceError] {
    var surface: u64 = 0;
    c.glfwGetError(nil);
    val result: i32 = c.glfwCreateWindowSurface(instance, window.handle, nil, ?surface);
    if (result == 0) { ret res[u64, SurfaceError].ok{surface}; }
    val recorded: opt[Error] = error.take_error();
    # the platform reports its failed surface call as platform_error, and the
    # VkResult says more than that
    if (sel recorded.some) {
        if (!sel recorded.some.platform_error) {
            ret res[u64, SurfaceError].err{SurfaceError.glfw{recorded.some}};
        }
    }
    ret res[u64, SurfaceError].err{SurfaceError.vulkan{result}};
}

# Address of a Vulkan core or instance-level function.
#
# Passing a nil instance resolves the small set of functions available before
# one exists, such as vkCreateInstance.
# ---
# instance: the instance to resolve against, or nil
# procname: function name
# ret:      function address, or none if Vulkan does not provide it
pub fun get_instance_proc_address(instance: ptr, procname: str) opt[ptr] {
    val address: ptr = c.glfwGetInstanceProcAddress(instance, procname);
    if (address == nil) { ret opt[ptr].none{}; }
    ret opt[ptr].some{address};
}
