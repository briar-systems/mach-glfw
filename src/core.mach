# library lifecycle, events, timing, and context management
#
# wraps initialization, the event loop, the timer, and the OpenGL context
# plumbing. all functions are thin wrappers over glfw.c with mach-idiomatic
# types. the error query lives in glfw.error.

use glfw.c;
use glfw.error;
use glfw.error.Error;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

# connection events delivered to monitor and joystick callbacks.
pub val CONNECTED:    i32 = 0x00040001;
pub val DISCONNECTED: i32 = 0x00040002;

# error callback. receives an error code and a UTF-8 description
pub def ErrorFun: fun(i32, *u8);

# initialize the GLFW library. call before most other functions
# ---
# ret: ok, or why no platform could be initialized
pub fun init() err[Error] {
    c.glfwGetError(nil);
    if (c.glfwInit() == 0) { ret err[Error].err{error.take_refusal()}; }
    ret err[Error].ok{};
}

# destroy all windows and free GLFW resources
pub fun terminate() {
    c.glfwTerminate();
}

# set an init hint before init. see glfw.hint for ids and values
# ---
# hint:  init hint id
# value: hint value
pub fun init_hint(hint: i32, value: i32) {
    c.glfwInitHint(hint, value);
}

# retrieve the run-time GLFW version
# ---
# major: receives the major version
# minor: receives the minor version
# rev:   receives the revision
pub fun get_version(major: *i32, minor: *i32, rev: *i32) {
    c.glfwGetVersion(major, minor, rev);
}

# compile-time GLFW version and configuration string
# ---
# ret: static, GLFW-owned string
pub fun get_version_string() str {
    ret c.glfwGetVersionString();
}

# the platform selected at init. see hint.PLATFORM_* values
# ---
# ret: platform id, or 0 before init
pub fun get_platform() i32 {
    ret c.glfwGetPlatform();
}

# whether the library was compiled with a platform
# ---
# platform: a hint.PLATFORM_* value
# ret:      true if supported
pub fun platform_supported(platform: i32) bool {
    ret c.glfwPlatformSupported(platform) != 0;
}

# install the global error callback
#
# callable before init. the previous callback is dropped. the callback receives
# the raw code, which error.error_from_code classifies, and the description.
# ---
# callback: error handler, or nil::ErrorFun to clear
pub fun set_error_callback(callback: ErrorFun) {
    c.glfwSetErrorCallback(callback);
}

# process pending events and return immediately
pub fun poll_events() {
    c.glfwPollEvents();
}

# block until at least one event arrives, then process all
pub fun wait_events() {
    c.glfwWaitEvents();
}

# wait_events, but give up after timeout seconds
# ---
# timeout: maximum wait in seconds
pub fun wait_events_timeout(timeout: f64) {
    c.glfwWaitEventsTimeout(timeout);
}

# wake the event loop from another thread
pub fun post_empty_event() {
    c.glfwPostEmptyEvent();
}

# seconds elapsed since init (or the last set_time)
# ---
# ret: time in seconds
pub fun get_time() f64 {
    ret c.glfwGetTime();
}

# reset the GLFW time base
# ---
# time: new time in seconds
pub fun set_time(time: f64) {
    c.glfwSetTime(time);
}

# current raw timer value in ticks
# ---
# ret: timer value
pub fun get_timer_value() u64 {
    ret c.glfwGetTimerValue();
}

# raw timer frequency in ticks per second
# ---
# ret: timer frequency
pub fun get_timer_frequency() u64 {
    ret c.glfwGetTimerFrequency();
}

# set the buffer-swap interval for the current context
# ---
# interval: minimum frames between swaps (1 enables vsync)
pub fun swap_interval(interval: i32) {
    c.glfwSwapInterval(interval);
}

# whether the current context supports an extension
# ---
# extension: extension name
# ret:       true if supported
pub fun extension_supported(extension: str) bool {
    ret c.glfwExtensionSupported(extension) != 0;
}

# address of an OpenGL (ES) function for the current
# context. reinterpret the result as the proper fun type before calling
# ---
# procname: function name
# ret:      function address, or none if the context does not provide it
pub fun get_proc_address(procname: str) opt[ptr] {
    val address: ptr = c.glfwGetProcAddress(procname);
    if (address == nil) { ret opt[ptr].none{}; }
    ret opt[ptr].some{address};
}

var test_cb_code: i64 = 0;

fun test_error_cb(code: i32, desc: *u8) {
    test_cb_code = code::i64;
}

# display-free: relies on GLFW being uninitialized, so it must not run
# after any test that calls init().
test "core: error callback fires with not_initialized before init" {
    test_cb_code = 0;
    set_error_callback(test_error_cb);
    c.glfwGetError(nil);
    c.glfwCreateWindow(1, 1, "t", nil, nil);
    set_error_callback(nil::ErrorFun);
    val reported: opt[Error] = error.error_from_code(test_cb_code::i32);
    if (!sel reported.some)                 { ret 1; }
    if (!sel reported.some.not_initialized) { ret 2; }
    val taken: Error = error.take_refusal();
    if (!sel taken.not_initialized) { ret 3; }
    val cleared: opt[Error] = error.take_error();
    if (!sel cleared.none) { ret 4; }
    ret 0;
}

test "core: get_version matches linked 3.x" {
    var major: i32 = 0;
    var minor: i32 = 0;
    var rev:   i32 = 0;
    get_version(?major, ?minor, ?rev);
    if (major != 3) { ret 1; }
    ret 0;
}
