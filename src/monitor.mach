# monitor enumeration, properties, video modes, and gamma
#
# a Monitor is a by-value wrapper around a live GLFWmonitor handle.
# handles stay valid until the monitor is disconnected or the library
# terminates. watch set_monitor_callback for changes.

use glfw.c;
use std.types.option.opt;
use std.types.string.str;

# handle to a connected monitor
# ---
# handle: opaque GLFWmonitor pointer, never nil
pub rec Monitor {
    handle: ptr;
}

# monitor configuration callback (monitor, core.CONNECTED or
# core.DISCONNECTED)
pub def MonitorFun: fun(ptr, i32);

# rewrap a raw handle received in a callback
# ---
# handle: opaque GLFWmonitor pointer
# ret:    the wrapped Monitor
pub fun monitor_from_handle(handle: ptr) Monitor {
    ret Monitor{handle: handle};
}

# array of all connected monitors
# ---
# count: receives the monitor count, zero when there are none
# ret:   GLFW-owned array of opaque handles, count entries long
pub fun get_monitors(count: *i32) *ptr {
    ret c.glfwGetMonitors(count);
}

# the user's primary monitor
# ---
# ret: the primary Monitor, or none if no monitor is connected
pub fun get_primary_monitor() opt[Monitor] {
    val handle: ptr = c.glfwGetPrimaryMonitor();
    if (handle == nil) { ret opt[Monitor].none{}; }
    ret opt[Monitor].some{Monitor{handle: handle}};
}

# position of the monitor on the virtual desktop
# ---
# monitor: monitor to query
# xpos:    receives the x position
# ypos:    receives the y position
pub fun get_monitor_pos(monitor: Monitor, xpos: *i32, ypos: *i32) {
    c.glfwGetMonitorPos(monitor.handle, xpos, ypos);
}

# work area of the monitor, excluding taskbars
# ---
# monitor: monitor to query
# xpos:    receives the x position
# ypos:    receives the y position
# width:   receives the width
# height:  receives the height
pub fun get_monitor_workarea(monitor: Monitor, xpos: *i32, ypos: *i32, width: *i32, height: *i32) {
    c.glfwGetMonitorWorkarea(monitor.handle, xpos, ypos, width, height);
}

# physical size of the display in millimetres
# ---
# monitor:   monitor to query
# width_mm:  receives the width
# height_mm: receives the height
pub fun get_monitor_physical_size(monitor: Monitor, width_mm: *i32, height_mm: *i32) {
    c.glfwGetMonitorPhysicalSize(monitor.handle, width_mm, height_mm);
}

# content scale of the monitor
# ---
# monitor: monitor to query
# xscale:  receives the x scale
# yscale:  receives the y scale
pub fun get_monitor_content_scale(monitor: Monitor, xscale: *f32, yscale: *f32) {
    c.glfwGetMonitorContentScale(monitor.handle, xscale, yscale);
}

# human-readable monitor name
# ---
# monitor: monitor to query
# ret:     GLFW-owned string, valid until disconnect, or none if glfw
#          refused the query
pub fun get_monitor_name(monitor: Monitor) opt[str] {
    val name: str = c.glfwGetMonitorName(monitor.handle);
    if (name == nil) { ret opt[str].none{}; }
    ret opt[str].some{name};
}

# attach a user pointer to the monitor
# ---
# monitor: monitor to tag
# pointer: arbitrary user data
pub fun set_monitor_user_pointer(monitor: Monitor, pointer: ptr) {
    c.glfwSetMonitorUserPointer(monitor.handle, pointer);
}

# read the monitor's user pointer
# ---
# monitor: monitor to query
# ret:     the user pointer, nil if unset
pub fun get_monitor_user_pointer(monitor: Monitor) ptr {
    ret c.glfwGetMonitorUserPointer(monitor.handle);
}

# install the monitor configuration callback
# ---
# callback: handler, or nil::MonitorFun to clear
pub fun set_monitor_callback(callback: MonitorFun) {
    c.glfwSetMonitorCallback(callback);
}

# all video modes supported by the monitor
# ---
# monitor: monitor to query
# count:   receives the mode count, zero when glfw refused the query
# ret:     GLFW-owned array of video modes, count entries long
pub fun get_video_modes(monitor: Monitor, count: *i32) *c.Vidmode {
    ret c.glfwGetVideoModes(monitor.handle, count);
}

# current video mode of the monitor
# ---
# monitor: monitor to query
# ret:     GLFW-owned video mode, or none if glfw refused the query
pub fun get_video_mode(monitor: Monitor) opt[*c.Vidmode] {
    val mode: *c.Vidmode = c.glfwGetVideoMode(monitor.handle);
    if (mode == nil) { ret opt[*c.Vidmode].none{}; }
    ret opt[*c.Vidmode].some{mode};
}

# generate and set a gamma ramp from an exponent
# ---
# monitor: monitor to change
# gamma:   desired exponent, greater than zero
pub fun set_gamma(monitor: Monitor, gamma: f32) {
    c.glfwSetGamma(monitor.handle, gamma);
}

# current gamma ramp of the monitor
# ---
# monitor: monitor to query
# ret:     GLFW-owned ramp, or none if glfw refused the query
pub fun get_gamma_ramp(monitor: Monitor) opt[*c.Gammaramp] {
    val ramp: *c.Gammaramp = c.glfwGetGammaRamp(monitor.handle);
    if (ramp == nil) { ret opt[*c.Gammaramp].none{}; }
    ret opt[*c.Gammaramp].some{ramp};
}

# set the gamma ramp of the monitor
# ---
# monitor: monitor to change
# ramp:    ramp to apply, copied before return
pub fun set_gamma_ramp(monitor: Monitor, ramp: *c.Gammaramp) {
    c.glfwSetGammaRamp(monitor.handle, ramp);
}
